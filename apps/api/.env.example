PORT=3001
CORS_ORIGINS=http://localhost:3000
AUTH_REQUIRED=false
LOCAL_AUTH_ENABLED=true
# Solo para demos locales. Nunca habilitar en AWS.
LOCAL_AUTH_EXPOSE_CODES=false
JWT_SECRET=replace-with-a-long-random-value
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Con docker compose local:
# DATABASE_URL=postgresql://pickbros:pickbros@localhost:5432/pickbros

# The Odds API — solo backend. Nunca NEXT_PUBLIC_ ni el frontend.
THE_ODDS_API_KEY=
THE_ODDS_API_REGION=us
THE_ODDS_API_MARKETS=h2h,spreads,totals
THE_ODDS_API_BOOKMAKERS=
ODDS_PREMATCH_CACHE_TTL=60
ODDS_LIVE_CACHE_TTL=40
ODDS_PROPS_CACHE_TTL=60

