{
  "name": "pickbros-app",
  "private": true,
  "description": "Aplicación web y API de PickBros",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter @pickbros/types build && pnpm --filter web --filter api build",
    "lint": "pnpm --filter web --filter api lint",
    "test": "pnpm --filter web --filter api test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": ">=8.0.2",
      "fast-uri": ">=3.1.6",
      "js-yaml": ">=4.3.2",
      "multer": ">=2.3.0",
      "postcss": ">=8.5.23",
      "qs": ">=6.16.0",
      "sharp": ">=0.35.4"
    },
    "onlyBuiltDependencies": ["esbuild", "sharp", "unrs-resolver", "@prisma/client", "@prisma/engines", "prisma"]
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
